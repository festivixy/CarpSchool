# Carpool Application Environment Configuration
# Copy this file to .env and customize as needed

# Region Configuration
# Specifies the region name for data files (PBF and OSRM)
# This should match the region name used in your data files
# Examples: british-columbia, alberta, ontario, etc.
REGION=british-columbia

# Application Configuration
NODE_ENV=production

# ROOT_URL - Used for email links and client routing
# Development (local meteor): http://localhost:3001
# Development (docker): http://localhost:3000
# Production: https://carp.school
ROOT_URL=https://carp.school

# MongoDB Configuration (required — no default; used for the mongo
# container's root credentials, the app's MONGO_URL, and mongo-backup)
MONGO_USER=admin
MONGO_PASSWORD=your-secure-mongo-password-here

# Security Configuration
# Mongo Express Admin Interface Credentials (required — no default)
# IMPORTANT: Change these credentials in production!
MONGO_EXPRESS_USERNAME=admin
MONGO_EXPRESS_PASSWORD=your-secure-password-here

# Clerk Authentication Configuration
# Get these from Clerk Dashboard → API Keys
# https://dashboard.clerk.com/last-active?path=api-keys
CLERK_SECRET_KEY=sk_test_your_secret_key_here

# Persona identity-verification webhook signing secret
PERSONA_WEBHOOK_SECRET=your-persona-webhook-secret-here

# GitHub webhook signing secret for devActionsServer deploy hook
GITHUB_WEBHOOK_SECRET=your-github-webhook-secret-here

# Seed the database with default/sample data on first boot (leave unset to skip)
# SEED_DATABASE=1

# CodePush admin panel credentials (required for non-interactive CLI login)
CODEPUSH_ADMIN_USER=admin@carp.school
CODEPUSH_ADMIN_PASSWORD=your-secure-codepush-password-here

# Push Notification Configuration
# Choose notification backend: 'firebase' (default) or 'onesignal'
NOTIFICATION_BACKEND=firebase

# Firebase Configuration (for Firebase backend)
# Get these from Firebase Console → Project Settings → Service Accounts
# FIREBASE_PROJECT_ID=your-firebase-project-id
# FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project.iam.gserviceaccount.com
# FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYour private key here\n-----END PRIVATE KEY-----"

# OneSignal Configuration (for OneSignal backend)
# Get these from OneSignal Dashboard → Settings → Keys & IDs
# ONESIGNAL_APP_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
# ONESIGNAL_API_KEY=YWFhYWFhYWEtYWFhYS1hYWFhLWFhYWEtYWFhYWFhYWFhYWFh

# Web Push / VAPID Configuration
VAPID_SUBJECT=mailto:your-email@domain.com
# VAPID_PUBLIC_KEY=your-vapid-public-key-here
# VAPID_PRIVATE_KEY=your-vapid-private-key-here
