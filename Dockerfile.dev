FROM node:26-slim

SHELL ["/bin/bash", "-o", "pipefail", "-c"]

# Install Meteor
RUN curl -fsSL https://install.meteor.com/?release=3.3.1 | sh

# Set working directory
WORKDIR /app

# Cache npm deps layer before the source is bind-mounted in
# (plain npm, not `meteor npm`, since .meteor/ isn't present at build time)
COPY app/package.json app/package-lock.json ./
RUN npm install --legacy-peer-deps

# Expose ports
EXPOSE 3001 3002

# Set environment
ENV METEOR_ALLOW_SUPERUSER=true
ENV PATH="/root/.meteor:${PATH}"

# Default command
CMD ["meteor", "--no-release-check", "--port", "3001"]
